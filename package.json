{
  "name": "chilla",
  "version": "0.1.14",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tauri-e2e.json",
    "typecheck:tauri:e2e": "tsc --noEmit -p tsconfig.tauri-e2e.json",
    "lint": "bun run lint:ts",
    "lint:biome": "biome check . --diagnostic-level=warn",
    "lint:ts": "bun run lint:biome && bun run typecheck",
    "format": "biome format --write src scripts tests vite.config.ts vitest.config.ts",
    "format:check": "biome format --check src scripts tests vite.config.ts vitest.config.ts",
    "test": "bun test ./src/features/file-view/sort.test.ts ./src/features/preview/preview-assets.test.ts ./src/features/toc/heading-tree.test.ts ./src/features/workspace/openFiles.test.ts ./src/features/workspace/workspacePreviewModel.test.ts",
    "test:dom": "vitest run --config vitest.config.ts",
    "test:tauri:e2e:linux": "bash scripts/run-tauri-e2e-linux.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "2.7.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "katex": "^0.16.40",
    "mermaid": "^11",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.3",
    "@types/katex": "^0.16.8",
    "@types/selenium-webdriver": "^4.35.5",
    "@biomejs/biome": "^1.9.4",
    "github-markdown-css": "^5.9.0",
    "jsdom": "^29.0.1",
    "selenium-webdriver": "^4.41.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.0"
  }
}
