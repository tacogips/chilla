{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chilla-product",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "routes": [
    {
      "pattern": "chilla-viewer.com",
      "custom_domain": true
    },
    {
      "pattern": "www.chilla-viewer.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
