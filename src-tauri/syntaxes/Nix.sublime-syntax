%YAML 1.2
---
# http://www.sublimetext.com/docs/3/syntax.html
name: Nix

file_extensions:
  - nix

scope: source.nix

contexts:
  main:
    - include: comments
    - include: strings
    - include: keywords
    - include: constants
    - include: numbers
    - include: urls
    - include: paths
    - include: attribute-name
    - include: operators

  comments:
    - match: '#.*$'
      scope: comment.line.number-sign.nix
    - match: '/\*'
      scope: punctuation.definition.comment.begin.nix
      push:
        - meta_scope: comment.block.nix
        - match: '\*/'
          scope: punctuation.definition.comment.end.nix
          pop: true

  keywords:
    - match: '\b(let|in|with|rec|inherit|if|then|else|assert|or|import)\b'
      scope: keyword.control.nix

  constants:
    - match: '\b(true|false|null)\b'
      scope: constant.language.nix

  numbers:
    - match: '\b[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?\b'
      scope: constant.numeric.nix

  urls:
    - match: "\\b[a-zA-Z][a-zA-Z0-9+.-]*://[^\\s\"'\\)\\];,]+"
      scope: constant.other.url.nix

  paths:
    - match: '(?<![\w./])(\.{1,2}/|~/|/)[\w.\-+/]*'
      scope: string.unquoted.path.nix

  attribute-name:
    - match: "[A-Za-z_][A-Za-z0-9_'-]*(?=\\s*=[^=])"
      scope: entity.other.attribute-name.nix

  operators:
    - match: '\+\+|//|&&|\|\||->|==|!=|<=|>=|[+\-*/<>!?:@=]'
      scope: keyword.operator.nix

  strings:
    - match: "''"
      scope: punctuation.definition.string.begin.nix
      push: indented-string
    - match: '"'
      scope: punctuation.definition.string.begin.nix
      push: double-quoted-string

  double-quoted-string:
    - meta_scope: string.quoted.double.nix
    - match: '\\.'
      scope: constant.character.escape.nix
    - match: '\$\{'
      scope: punctuation.section.interpolation.begin.nix
      push:
        - meta_content_scope: meta.embedded.line.nix
        - match: '\}'
          scope: punctuation.section.interpolation.end.nix
          pop: true
        - include: main
    - match: '"'
      scope: punctuation.definition.string.end.nix
      pop: true

  indented-string:
    - meta_scope: string.quoted.other.indented.nix
    - match: "'''"
      scope: constant.character.escape.nix
    - match: "''\\$"
      scope: constant.character.escape.nix
    - match: '\$\{'
      scope: punctuation.section.interpolation.begin.nix
      push:
        - meta_content_scope: meta.embedded.line.nix
        - match: '\}'
          scope: punctuation.section.interpolation.end.nix
          pop: true
        - include: main
    - match: "''"
      scope: punctuation.definition.string.end.nix
      pop: true
